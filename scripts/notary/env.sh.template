#!/bin/bash

# Notarization Environment Variables
#
# Copy this file to env.sh and fill in your details.
# **IMPORTANT**: Add env.sh to .gitignore and DO NOT commit it to the repository.

# --- Apple Developer Account Information ---

# --- App Store Connect API Key ---
# Generate at: https://appstoreconnect.apple.com/access/api

# Key ID (e.g., XXXXXXXXXX)
export AC_API_KEY_ID="[Your API Key ID]"

# Issuer ID (UUID, e.g., xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx)
export AC_API_KEY_ISSUER_ID="[Your Issuer ID]"

# Path to your .p8 API Key file.
# Specify as a path relative to this script, or an absolute path.
# Example: "private/AuthKey_XXXXXXXXXX.p8"
export AC_API_KEY_PATH="[Path to your .p8 file]"


# --- Developer ID Certificate ---
# Export your Developer ID Application certificate (.p12) from Keychain Access.app.

# Path to your .p12 file.
# Specify as a path relative to this script, or an absolute path.
# Example: "private/DeveloperID.p12"
export CERTIFICATE_P12_PATH="[Path to your .p12 file]"

# Password set when exporting the .p12 file.
# This password is used when importing the certificate into the temporary keychain.
export CERTIFICATE_PASSWORD="[Your .p12 file password]"

# --- Application Information ---

# Application's Bundle Identifier.
# Must match PRODUCT_BUNDLE_IDENTIFIER in apps/desktop/macos/Runner/Configs/AppInfo.xcconfig.
export BUNDLE_ID="jp.szktty.RinneGraph"
